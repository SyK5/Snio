generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  username_changed_at DateTime? @db.Timestamptz(6)
  discriminator     String    @db.Char(4)
  pending_fields    String[]  @default([])
  email_verified    Boolean   @default(false)
  is_platform_admin Boolean   @default(false)
  password_hash     String
  display_name      String
  avatar_url        String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)

  sessions               Session[]
  refreshTokens          RefreshToken[]
  memberships            ClanMember[]
  ownedClans             Clan[]                  @relation("ClanOwner")
  createdClanInvites     ClanInvite[]            @relation("ClanInviteCreator")
  receivedClanInvites    ClanInvite[]            @relation("ClanInviteTarget")
  ownedClanGames         ClanGame[]              @relation("ClanGameOwner")
  eventParticipations    EventParticipation[]
  trainingParticipations TrainingParticipation[]
  leagueRosterEntries    LeagueRoster[]
  chatChannelMembers     ChatChannelMember[]
  chatMessages           ChatMessage[]
  chatMessageReactions   ChatMessageReaction[]
  chatMessageMentions    ChatMessageMention[]
  chatMessageEdits       ChatMessageEdit[]
  customEmojis           CustomEmoji[]
  stickers               Sticker[]
  callSessionsStarted    CallSession[]
  callParticipations     CallParticipant[]
  devices                UserDevice[]
  notifications          Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs              AuditLog[]
  documents              Document[]              @relation("DocumentRecipient")
  generatedDocuments     Document[]              @relation("DocumentGeneratedBy")

  @@unique([display_name, discriminator])
  @@index([deleted_at])
  @@map("snio_users")
}

model Session {
  id         String   @id @default(cuid())
  user_id    String
  ip_address String?
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("snio_sessions")
}

model RefreshToken {
  id             String    @id @default(cuid())
  token_hash     String    @unique
  user_id        String
  replaced_by_id String?
  revoked_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  expires_at     DateTime  @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("snio_refresh_tokens")
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  token_hash String   @unique
  email      String
  user_id    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)

  @@index([email])
  @@map("snio_email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  token_hash String    @unique
  user_id    String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)

  @@index([user_id])
  @@map("snio_password_reset_tokens")
}

model Game {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon_url    String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  clanGames ClanGame[]
  events    Event[]
  leagues   League[]

  @@index([deleted_at])
  @@map("snio_games")
}

model Clan {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  tag         String    @unique
  description String?
  logo_url    String?
  join_policy JoinPolicy @default(OPEN)
  owner_id    String
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  owner              User                @relation("ClanOwner", fields: [owner_id], references: [id])
  members            ClanMember[]
  roles              ClanRoleDef[]
  games              ClanGame[]
  events             Event[]
  trainings          Training[]
  leagueParticipants LeagueParticipant[]
  chatChannels       ChatChannel[]
  customEmojis       CustomEmoji[]
  stickers           Sticker[]
  documents          Document[]
  invites            ClanInvite[]

  @@index([owner_id])
  @@index([deleted_at])
  @@map("snio_clans")
}

model ClanMember {
  id        String    @id @default(cuid())
  clan_id   String
  user_id   String
  joined_at DateTime  @default(now()) @db.Timestamptz(6)
  left_at   DateTime? @db.Timestamptz(6)

  clan  Clan             @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  roles ClanMemberRole[]

  @@unique([clan_id, user_id])
  @@index([user_id])
  @@map("snio_clan_members")
}

model ClanRoleDef {
  id         String   @id @default(cuid())
  clan_id    String
  key        String
  name       String
  color      String?
  is_system  Boolean  @default(false)
  position   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  clan     Clan                 @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  grants   ClanRoleGrant[]
  members  ClanMemberRole[]
  mentions ChatMessageMention[]

  @@unique([clan_id, key])
  @@index([clan_id])
  @@map("snio_clan_roles")
}

model ClanRoleGrant {
  id      String @id @default(cuid())
  role_id String
  grant   String
  actions Int    @default(0)

  role ClanRoleDef @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, grant])
  @@index([role_id])
  @@map("snio_clan_role_grants")
}

model ClanMemberRole {
  id          String   @id @default(cuid())
  member_id   String
  role_id     String
  assigned_at DateTime @default(now()) @db.Timestamptz(6)

  member ClanMember  @relation(fields: [member_id], references: [id], onDelete: Cascade)
  role   ClanRoleDef @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([member_id, role_id])
  @@index([role_id])
  @@map("snio_clan_member_roles")
}

model ClanInvite {
  id             String    @id @default(cuid())
  code           String    @unique
  clan_id        String
  created_by_id  String
  target_user_id String?
  max_uses       Int?
  uses           Int       @default(0)
  expires_at     DateTime? @db.Timestamptz(6)
  revoked_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  clan       Clan  @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  createdBy  User  @relation("ClanInviteCreator", fields: [created_by_id], references: [id])
  targetUser User? @relation("ClanInviteTarget", fields: [target_user_id], references: [id], onDelete: Cascade)

  @@index([clan_id])
  @@index([target_user_id])
  @@map("snio_clan_invites")
}

enum JoinPolicy {
  OPEN
  INVITE_ONLY
  CLOSED

  @@map("snio_join_policy")
}

model ClanGame {
  id         String   @id @default(cuid())
  clan_id    String
  game_id    String
  owner_id   String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  clan  Clan @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  game  Game @relation(fields: [game_id], references: [id])
  owner User @relation("ClanGameOwner", fields: [owner_id], references: [id])

  @@unique([clan_id, game_id])
  @@unique([owner_id, game_id])
  @@index([game_id])
  @@map("snio_clan_games")
}

model Event {
  id            String    @id @default(cuid())
  clan_id       String
  game_id       String
  title         String
  description   String?
  starts_at     DateTime  @db.Timestamptz(6)
  ends_at       DateTime? @db.Timestamptz(6)
  location      String?
  ruleset       String?
  created_by_id String
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  clan           Clan                 @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  game           Game                 @relation(fields: [game_id], references: [id])
  participations EventParticipation[]
  documents      Document[]

  @@index([clan_id])
  @@index([starts_at])
  @@index([deleted_at])
  @@map("snio_events")
}

model EventParticipation {
  id         String              @id @default(cuid())
  event_id   String
  user_id    String
  status     ParticipationStatus @default(PENDING)
  created_at DateTime            @default(now()) @db.Timestamptz(6)

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@map("snio_event_participations")
}

enum ParticipationStatus {
  PENDING
  CONFIRMED
  DECLINED

  @@map("snio_participation_status")
}

model Training {
  id            String    @id @default(cuid())
  clan_id       String
  title         String
  description   String?
  starts_at     DateTime  @db.Timestamptz(6)
  ends_at       DateTime? @db.Timestamptz(6)
  created_by_id String
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  clan           Clan                    @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  participations TrainingParticipation[]
  documents      Document[]

  @@index([clan_id])
  @@index([starts_at])
  @@index([deleted_at])
  @@map("snio_trainings")
}

model TrainingParticipation {
  id          String              @id @default(cuid())
  training_id String
  user_id     String
  status      ParticipationStatus @default(PENDING)
  created_at  DateTime            @default(now()) @db.Timestamptz(6)

  training Training @relation(fields: [training_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([training_id, user_id])
  @@map("snio_training_participations")
}

model League {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  game_id     String
  starts_at   DateTime? @db.Timestamptz(6)
  ends_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  game         Game                @relation(fields: [game_id], references: [id])
  participants LeagueParticipant[]
  rosters      LeagueRoster[]
  documents    Document[]

  @@index([game_id])
  @@index([deleted_at])
  @@map("snio_leagues")
}

model LeagueParticipant {
  id        String   @id @default(cuid())
  league_id String
  clan_id   String
  joined_at DateTime @default(now()) @db.Timestamptz(6)

  league League         @relation(fields: [league_id], references: [id], onDelete: Cascade)
  clan   Clan           @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  roster LeagueRoster[]

  @@unique([league_id, clan_id])
  @@index([clan_id])
  @@map("snio_league_participants")
}

model LeagueRoster {
  id             String   @id @default(cuid())
  participant_id String
  league_id      String
  user_id        String
  added_at       DateTime @default(now()) @db.Timestamptz(6)

  participant LeagueParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  league      League            @relation(fields: [league_id], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([league_id, user_id])
  @@index([participant_id])
  @@index([user_id])
  @@map("snio_league_rosters")
}

model ChatChannel {
  id              String          @id @default(cuid())
  type            ChatChannelType
  clan_id         String?
  parent_id       String?
  name            String?
  topic           String?
  icon_url        String?
  position        Int             @default(0)
  last_message_at DateTime?       @db.Timestamptz(6)
  archived_at     DateTime?       @db.Timestamptz(6)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?       @db.Timestamptz(6)

  clan     Clan?               @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  parent   ChatChannel?        @relation("ChannelThreads", fields: [parent_id], references: [id])
  threads  ChatChannel[]       @relation("ChannelThreads")
  members  ChatChannelMember[]
  messages ChatMessage[]
  calls    CallSession[]

  @@index([clan_id])
  @@index([parent_id])
  @@index([last_message_at])
  @@index([deleted_at])
  @@map("snio_chat_channels")
}

enum ChatChannelType {
  CLAN
  DIRECT
  GROUP
  THREAD

  @@map("snio_chat_channel_type")
}

model ChatChannelMember {
  id                   String            @id @default(cuid())
  channel_id           String
  user_id              String
  notification_level   NotificationLevel @default(ALL)
  mute_state           MuteState         @default(ACTIVE)
  muted_until          DateTime?         @db.Timestamptz(6)
  last_read_at         DateTime?         @db.Timestamptz(6)
  last_read_message_id String?
  joined_at            DateTime          @default(now()) @db.Timestamptz(6)

  channel ChatChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([channel_id, user_id])
  @@index([user_id])
  @@map("snio_chat_channel_members")
}

enum NotificationLevel {
  ALL
  MENTIONS_ONLY
  NONE

  @@map("snio_notification_level")
}

enum MuteState {
  ACTIVE
  MUTED_TEMP
  MUTED_FOREVER

  @@map("snio_mute_state")
}

model ChatMessage {
  id             String      @id @default(cuid())
  channel_id     String
  user_id        String
  type           MessageType @default(TEXT)
  content        String?
  reply_to_id    String?
  thread_root_id String?
  device_type    DeviceType  @default(WEB)
  pinned_at      DateTime?   @db.Timestamptz(6)
  edited_at      DateTime?   @db.Timestamptz(6)
  metadata       Json?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?   @db.Timestamptz(6)

  channel     ChatChannel             @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  user        User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  replyTo     ChatMessage?            @relation("MessageReplies", fields: [reply_to_id], references: [id])
  replies     ChatMessage[]           @relation("MessageReplies")
  threadRoot  ChatMessage?            @relation("MessageThread", fields: [thread_root_id], references: [id])
  threadItems ChatMessage[]           @relation("MessageThread")
  attachments ChatMessageAttachment[]
  reactions   ChatMessageReaction[]
  mentions    ChatMessageMention[]
  edits       ChatMessageEdit[]
  embeds      ChatMessageEmbed[]

  @@index([channel_id, created_at])
  @@index([user_id])
  @@index([reply_to_id])
  @@index([thread_root_id])
  @@index([deleted_at])
  @@map("snio_chat_messages")
}

enum MessageType {
  TEXT
  SYSTEM
  IMAGE
  VIDEO
  AUDIO
  VOICE_MESSAGE
  FILE
  STICKER
  GIF
  EMOJI
  REPLY
  THREAD_START
  CALL
  CALL_MISSED
  USER_JOIN
  USER_LEAVE
  USER_KICK
  USER_BAN
  CHANNEL_RENAME
  CHANNEL_ICON_CHANGE
  PIN
  UNPIN
  POLL
  LOCATION
  STREAM
  SCREENSHARE
  COMMAND
  EPHEMERAL

  @@map("snio_message_type")
}

enum DeviceType {
  WEB
  MOBILE_IOS
  MOBILE_ANDROID
  DESKTOP
  API

  @@map("snio_device_type")
}

model ChatMessageAttachment {
  id                String         @id @default(cuid())
  message_id        String
  type              AttachmentType
  file_name_on_disk String
  original_name     String
  mime_type         String
  size_bytes        Int
  s3_bucket         String
  s3_key            String
  checksum          String?
  width             Int?
  height            Int?
  duration_seconds  Int?
  thumbnail_s3_key  String?
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?      @db.Timestamptz(6)

  message ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@map("snio_chat_message_attachments")
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  VOICE
  PDF
  ARCHIVE
  DOCUMENT
  CODE
  SPREADSHEET
  MODEL_3D
  OTHER

  @@map("snio_attachment_type")
}

model ChatMessageReaction {
  id              String       @id @default(cuid())
  message_id      String
  user_id         String
  type            ReactionType @default(EMOJI)
  reaction_key    String
  custom_emoji_id String?
  created_at      DateTime     @default(now()) @db.Timestamptz(6)

  message     ChatMessage  @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  customEmoji CustomEmoji? @relation(fields: [custom_emoji_id], references: [id])

  @@unique([message_id, user_id, reaction_key])
  @@index([message_id])
  @@map("snio_chat_message_reactions")
}

enum ReactionType {
  EMOJI
  CUSTOM_EMOJI
  STICKER

  @@map("snio_reaction_type")
}

model ChatMessageMention {
  id                String      @id @default(cuid())
  message_id        String
  type              MentionType
  mentioned_user_id String?
  mentioned_role_id String?
  created_at        DateTime    @default(now()) @db.Timestamptz(6)

  message       ChatMessage  @relation(fields: [message_id], references: [id], onDelete: Cascade)
  mentionedUser User?        @relation(fields: [mentioned_user_id], references: [id], onDelete: Cascade)
  mentionedRole ClanRoleDef? @relation(fields: [mentioned_role_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@index([mentioned_user_id])
  @@index([mentioned_role_id])
  @@map("snio_chat_message_mentions")
}

enum MentionType {
  USER
  ROLE
  EVERYONE
  HERE

  @@map("snio_mention_type")
}

model ChatMessageEmbed {
  id            String    @id @default(cuid())
  message_id    String
  type          EmbedType @default(LINK)
  url           String
  title         String?
  description   String?
  image_url     String?
  thumbnail_url String?
  provider      String?
  width         Int?
  height        Int?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  message ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@map("snio_chat_message_embeds")
}

enum EmbedType {
  LINK
  GIF
  IMAGE
  VIDEO
  ARTICLE
  RICH

  @@map("snio_embed_type")
}

model ChatMessageEdit {
  id               String     @id @default(cuid())
  message_id       String
  previous_content String?
  new_content      String?
  content_hash     String
  previous_hash    String?
  edited_by_id     String
  device_type      DeviceType @default(WEB)
  ip_address       String?
  edited_at        DateTime   @default(now()) @db.Timestamptz(6)

  message  ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  editedBy User        @relation(fields: [edited_by_id], references: [id])

  @@index([message_id, edited_at])
  @@map("snio_chat_message_edits")
}

model CustomEmoji {
  id            String    @id @default(cuid())
  clan_id       String
  name          String
  s3_key        String
  cdn_url       String
  animated      Boolean   @default(false)
  created_by_id String
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  clan      Clan                  @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  createdBy User                  @relation(fields: [created_by_id], references: [id])
  reactions ChatMessageReaction[]

  @@unique([clan_id, name])
  @@index([clan_id])
  @@map("snio_custom_emojis")
}

model Sticker {
  id            String    @id @default(cuid())
  clan_id       String?
  name          String
  s3_key        String
  cdn_url       String
  animated      Boolean   @default(false)
  created_by_id String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  clan      Clan? @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [created_by_id], references: [id])

  @@index([clan_id])
  @@map("snio_stickers")
}

model CallSession {
  id            String     @id @default(cuid())
  channel_id    String
  type          CallType   @default(VOICE)
  status        CallStatus @default(RINGING)
  started_by_id String
  started_at    DateTime   @default(now()) @db.Timestamptz(6)
  ended_at      DateTime?  @db.Timestamptz(6)

  channel      ChatChannel       @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  startedBy    User              @relation(fields: [started_by_id], references: [id])
  participants CallParticipant[]

  @@index([channel_id])
  @@index([status])
  @@map("snio_call_sessions")
}

enum CallType {
  VOICE
  VIDEO

  @@map("snio_call_type")
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED

  @@map("snio_call_status")
}

model CallParticipant {
  id          String     @id @default(cuid())
  call_id     String
  user_id     String
  device_type DeviceType @default(WEB)
  joined_at   DateTime   @default(now()) @db.Timestamptz(6)
  left_at     DateTime?  @db.Timestamptz(6)

  call CallSession @relation(fields: [call_id], references: [id], onDelete: Cascade)
  user User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([call_id, user_id])
  @@index([user_id])
  @@map("snio_call_participants")
}

model UserDevice {
  id           String     @id @default(cuid())
  user_id      String
  type         DeviceType
  name         String?
  push_token   String?
  user_agent   String?
  last_seen_at DateTime?  @db.Timestamptz(6)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  revoked_at   DateTime?  @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("snio_user_devices")
}

model Notification {
  id         String           @id @default(cuid())
  user_id    String
  type       NotificationType
  payload    Json
  read_at    DateTime?        @db.Timestamptz(6)
  created_at DateTime         @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at])
  @@index([user_id, created_at])
  @@map("snio_notifications")
}

enum NotificationType {
  MESSAGE_NEW
  MESSAGE_MENTION
  MESSAGE_REPLY
  MESSAGE_REACTION
  THREAD_REPLY
  CHANNEL_INVITE
  CLAN_INVITE
  CLAN_ROLE_CHANGED
  CLAN_KICKED
  CLAN_MEMBER_JOINED
  EVENT_INVITE
  EVENT_REMINDER
  EVENT_UPDATED
  EVENT_CANCELLED
  TRAINING_INVITE
  TRAINING_REMINDER
  TRAINING_CANCELLED
  LEAGUE_ROSTER_ADDED
  LEAGUE_ROSTER_REMOVED
  LEAGUE_MATCH_SCHEDULED
  DOCUMENT_ISSUED
  SYSTEM_ANNOUNCEMENT
  ACCOUNT_SECURITY
  GAME_VOTE_STARTED
  GAME_VOTE_RESULT

  @@map("snio_notification_type")
}

model NotificationPreference {
  id         String           @id @default(cuid())
  user_id    String
  type       NotificationType
  enabled    Boolean          @default(true)
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  updated_at DateTime         @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, type])
  @@index([user_id])
  @@map("snio_notification_preferences")
}

model AuditLog {
  id          String      @id @default(cuid())
  actor_id    String?
  action      String
  entity_type String
  entity_id   String?
  metadata    Json?
  ip_address  String?
  device_type DeviceType?
  created_at  DateTime    @default(now()) @db.Timestamptz(6)

  actor User? @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([actor_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("snio_audit_logs")
}

model Document {
  id                String       @id @default(cuid())
  type              DocumentType
  title             String
  recipient_id      String?
  clan_id           String?
  event_id          String?
  training_id       String?
  league_id         String?
  generated_by_id   String?
  file_name_on_disk String
  s3_bucket         String
  s3_key            String
  mime_type         String       @default("application/pdf")
  size_bytes        Int
  checksum          String
  verification_code String       @unique
  template_version  String?
  metadata          Json?
  issued_at         DateTime     @default(now()) @db.Timestamptz(6)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?    @db.Timestamptz(6)

  recipient   User?     @relation("DocumentRecipient", fields: [recipient_id], references: [id], onDelete: SetNull)
  generatedBy User?     @relation("DocumentGeneratedBy", fields: [generated_by_id], references: [id], onDelete: SetNull)
  clan        Clan?     @relation(fields: [clan_id], references: [id], onDelete: SetNull)
  event       Event?    @relation(fields: [event_id], references: [id], onDelete: SetNull)
  training    Training? @relation(fields: [training_id], references: [id], onDelete: SetNull)
  league      League?   @relation(fields: [league_id], references: [id], onDelete: SetNull)

  @@index([recipient_id])
  @@index([clan_id])
  @@index([event_id])
  @@index([training_id])
  @@index([league_id])
  @@index([verification_code])
  @@index([deleted_at])
  @@map("snio_documents")
}

enum DocumentType {
  PARTICIPATION_CERTIFICATE
  ACHIEVEMENT_CERTIFICATE
  RANKING_CERTIFICATE
  EVENT_SUMMARY
  LEAGUE_REPORT
  INVOICE
  OTHER

  @@map("snio_document_type")
}
